{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WGSL",
  "scopeName": "source.wgsl",
  "fileTypes": ["wgsl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.wgsl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.wgsl",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.modifier.attribute.wgsl",
          "match": "@\\b(align|binding|builtin|compute|const|diagnostic|fragment|group|id|interpolate|invariant|location|must_use|size|vertex|workgroup_size)\\b"
        },
        {
          "name": "storage.modifier.attribute.wgsl",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wgsl",
          "match": "\\b(if|else|for|while|loop|switch|case|default|break|continue|continuing|return|discard)\\b"
        },
        {
          "name": "storage.type.wgsl",
          "match": "\\b(fn|let|var|const|override|alias|struct|enable|requires|diagnostic)\\b"
        },
        {
          "name": "storage.modifier.wgsl",
          "match": "\\b(private|workgroup|uniform|storage|function|read|write|read_write|push_constant|handle)\\b"
        },
        {
          "name": "constant.language.wgsl",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.wgsl",
          "match": "\\b(bool|i32|u32|f32|f16|i16|u16|f64|i64|u64)\\b"
        },
        {
          "name": "support.type.composite.wgsl",
          "match": "\\b(vec[2-4][hifu]?|mat[2-4]x[2-4][hf]?|atomic|array|ptr)\\b"
        },
        {
          "name": "support.type.texture.wgsl",
          "match": "\\b(texture_(1d|2d|2d_array|3d|cube|cube_array|multisampled_2d|depth_2d|depth_2d_array|depth_cube|depth_cube_array|depth_multisampled_2d|external|storage_1d|storage_2d|storage_2d_array|storage_3d)|sampler|sampler_comparison)\\b"
        },
        {
          "name": "support.type.sized.wgsl",
          "match": "\\b(rgba(8|16)(unorm|snorm|uint|sint|float)|r(g)?(8|16|32)(unorm|snorm|uint|sint|float)|rgb10a2(unorm|uint)|rg11b10float|bgra8unorm)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.wgsl",
          "match": "\\b0[xX][0-9a-fA-F]+(\\.[0-9a-fA-F]*)?([pP][-+]?\\d+)?[uifhUIFH]?\\b"
        },
        {
          "name": "constant.numeric.float.wgsl",
          "match": "\\b\\d+\\.\\d*([eE][-+]?\\d+)?[fhFH]?\\b|\\b\\.\\d+([eE][-+]?\\d+)?[fhFH]?\\b|\\b\\d+[eE][-+]?\\d+[fhFH]?\\b|\\b\\d+[fhFH]\\b"
        },
        {
          "name": "constant.numeric.integer.wgsl",
          "match": "\\b\\d+[uiUI]?\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wgsl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.wgsl", "match": "\\\\." }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.wgsl",
          "match": "(==|!=|<=|>=|&&|\\|\\||<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|->|::|[-+*/%&|^~!<>=?:])"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.wgsl" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.wgsl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
