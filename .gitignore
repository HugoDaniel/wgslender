# Build artifacts
/build/
/dist/
zig-out/
.zig-cache/
# Where `zig build` unpacks fetched dependencies (lsp_kit); the tarball itself
# is cached globally, so this is reproducible from build.zig.zon's url + hash.
zig-pkg/
/packages/rust/target/

# C example binaries (built from examples/c/Makefile)
/examples/c/minify
/examples/c/validate
/examples/c/reflect
/examples/c/rename
/examples/c/lint
/examples/c/lint_fix
/examples/c/compile
/examples/c/minify_and_reflect
/examples/c/remove_declaration_apply_by_id
/examples/c/change_type_apply_by_id

# JS/TS example (npm install + tsc output)
/examples/js-ts/node_modules/
/examples/js-ts/dist/

# Test artifacts
*.test
coverage.out
coverage.html
tests/testdata/*.minified
tests/testdata/tint/
tests/testdata/ucd/

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Private notes repository (git.hugodaniel.com/hugo/wgslender-ideas): the
# Obsidian vault, execution plans, and postmortems. Kept as a plain clone
# rather than a submodule so this repository carries no pointer to it.
/ideas/

# Reference checkouts of other projects, kept for reading rather than building.
# They used to be submodules, which meant `git clone --recursive` pulled a few
# hundred MB of unrelated repositories. Clone whatever you want to read here.
/external/

# Temp/scratch
/tmp/

# OS files
.DS_Store
Thumbs.db
