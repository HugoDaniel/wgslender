---
/**
 * The playground island.
 *
 * The shader is server-rendered into a `<pre>` so the page is readable
 * without JavaScript and there is no layout jump when the editor takes over.
 * The `<script>` below is wiring only — the models live in
 * `src/scripts/playground/panels.ts` and the DOM in `render.ts`, where Node
 * can test the first and a browser can check the second.
 *
 * The tabs are Starlight's own `<Tabs>`: its `processPanels` rehype pass only
 * rewrites the `<starlight-tab-item>` wrappers and leaves their children
 * alone, so island markup survives the round trip and the tabs come with
 * roles and arrow-key navigation already right.
 */
import { Tabs, TabItem } from '@astrojs/starlight/components';
import { sampleShader } from '../scripts/playground/sample-shader';
import { minifyOptions } from '../scripts/playground/panels';
---

{/*
	`not-content` is Starlight's own opt-out, and it is load-bearing here.
	Without it, `.sl-markdown-content :not(…) + :not(…)` in
	`style/markdown.css` puts `margin-top: var(--sl-content-gap-y)` between
	*every* adjacent pair of elements it can reach — including CodeMirror's
	`.cm-line` and `.cm-gutterElement` divs. That is not just cosmetic: it
	adds 16px between every line, so the editor's DOM geometry stops matching
	the height map CodeMirror measured, and clicking a line puts the cursor
	two lines away. Rename-at-the-cursor and hover both miss their targets.
*/}
<section class="playground not-content">
	<div class="pane">
		<header class="pane-head">
			<h2 class="pane-title">shader.wgsl</h2>
			<p class="pane-status" data-status>Starting the language server…</p>
		</header>
		<div class="pane-body editor" data-editor><pre class="fallback">{sampleShader}</pre></div>
	</div>

	<div class="pane">
		<div class="pane-body panels">
			<Tabs>
				<TabItem label="Minified">
					<div class="tab-body minify">
						<div class="pills">
							{
								minifyOptions.map((option) => (
									<label class="pill" title={option.help}>
										<input
											type="checkbox"
											data-option={option.key}
											checked={option.default}
										/>
										{option.label}
									</label>
								))
							}
						</div>
						<div class="stats-row">
							<div class="stats" data-minify-stats></div>
							<button type="button" class="copy" data-copy disabled>Copy</button>
						</div>
						<div class="notice" data-minify-errors hidden></div>
						<div class="minified" data-minify-output>
							<p class="empty">Loading the minifier…</p>
						</div>
					</div>
				</TabItem>

				<TabItem label="Reflection">
					<div class="tab-body scrolls" data-reflect>
						<p class="empty">Loading the minifier…</p>
					</div>
				</TabItem>

				<TabItem label="Diagnostics">
					<div class="tab-body scrolls" data-diagnostics>
						<p class="empty">Waiting for the language server…</p>
					</div>
				</TabItem>
			</Tabs>
		</div>
	</div>
</section>

<script>
	import { EditorState } from '@codemirror/state';
	import { lintGutter } from '@codemirror/lint';
	import { EditorView, lineNumbers } from '@codemirror/view';
	import { basicSetup } from 'codemirror';

	import { sampleShader, sampleUri } from '../scripts/playground/sample-shader';
	import { playgroundTheme } from '../scripts/playground/editor-theme';
	import { createSession } from '../scripts/playground/lsp-session';
	import { initPlayground } from '../scripts/playground/wasm';
	import { wgsl } from '../scripts/playground/wgsl-language';
	import {
		buildMinifyModel,
		buildReflectModel,
		defaultMinifyOptions,
		formatDiagnostics,
		type PanelMinifyOptions,
	} from '../scripts/playground/panels';
	import {
		gzipSize,
		renderDiagnostics,
		renderReflect,
		renderStats,
	} from '../scripts/playground/render';

	/** How long typing has to settle before the expensive half runs. */
	const DEBOUNCE_MS = 300;

	const host = document.querySelector<HTMLElement>('[data-editor]');
	const status = document.querySelector<HTMLElement>('[data-status]');
	const statsHost = document.querySelector<HTMLElement>('[data-minify-stats]');
	const errorsHost = document.querySelector<HTMLElement>('[data-minify-errors]');
	const outputHost = document.querySelector<HTMLElement>('[data-minify-output]');
	const reflectHost = document.querySelector<HTMLElement>('[data-reflect]');
	const diagnosticsHost = document.querySelector<HTMLElement>('[data-diagnostics]');
	const copyButton = document.querySelector<HTMLButtonElement>('[data-copy]');

	function setStatus(message: string, failed = false) {
		if (!status) return;
		status.textContent = message;
		status.classList.toggle('failed', failed);
	}

	/** Read the pills back out of the DOM, so the checkboxes are the state. */
	function readOptions(): PanelMinifyOptions {
		const options = defaultMinifyOptions();
		for (const box of document.querySelectorAll<HTMLInputElement>('[data-option]')) {
			const key = box.dataset.option as keyof PanelMinifyOptions;
			if (key in options) options[key] = box.checked;
		}
		return options;
	}

	async function boot(mount: HTMLElement) {
		// Both wasm downloads start now; only the language server is on the
		// critical path for showing an editor.
		const { lsp, minifier } = initPlayground();
		await lsp;

		const session = await createSession(sampleUri);
		mount.replaceChildren();

		let scheduled: ReturnType<typeof setTimeout> | undefined;
		const view = new EditorView({
			parent: mount,
			state: EditorState.create({
				doc: sampleShader,
				extensions: [
					basicSetup,
					lintGutter(),
					wgsl(),
					playgroundTheme,
					session.extension,
					EditorView.updateListener.of((update) => {
						if (!update.docChanged) return;
						clearTimeout(scheduled);
						scheduled = setTimeout(settled, DEBOUNCE_MS);
					}),
				],
			}),
		});
		setStatus('wgslender-lsp ready — it re-checks as you type');

		// Diagnostics come straight from the server, so the panel shows the
		// same codes and spec links the squiggles carry.
		session.onDiagnostics((payload) => {
			if (!diagnosticsHost) return;
			renderDiagnostics(diagnosticsHost, formatDiagnostics(payload), (position) => {
				const line = view.state.doc.line(position.line + 1);
				const at = Math.min(line.from + position.character, line.to);
				view.dispatch({ selection: { anchor: at }, scrollIntoView: true });
				view.focus();
			});
		});

		// The minified pane is an editor too — same mode and theme, no editing.
		await minifier;
		const minified = new EditorView({
			state: EditorState.create({
				doc: '',
				extensions: [
					lineNumbers(),
					wgsl(),
					playgroundTheme,
					EditorView.lineWrapping,
					EditorState.readOnly.of(true),
					EditorView.editable.of(false),
				],
			}),
		});
		outputHost?.replaceChildren(minified.dom);
		if (copyButton) copyButton.disabled = false;

		// Only the newest run may write the stats bar: gzip is async, and a
		// fast typist can have two passes in flight at once.
		let generation = 0;

		function refreshPanels() {
			const run = ++generation;
			const source = view.state.doc.toString();
			const model = buildMinifyModel(source, readOptions());

			minified.dispatch({
				changes: { from: 0, to: minified.state.doc.length, insert: model.code },
			});

			if (errorsHost) {
				errorsHost.replaceChildren(...model.errors.map((message) => {
					const line = document.createElement('p');
					line.textContent = message;
					return line;
				}));
				errorsHost.hidden = model.errors.length === 0;
			}

			if (statsHost) {
				renderStats(statsHost, model.stats, null);
				void gzipSize(model.code).then((bytes) => {
					if (run === generation && statsHost) renderStats(statsHost, model.stats, bytes);
				});
			}
			if (reflectHost) renderReflect(reflectHost, buildReflectModel(source));
		}

		function settled() {
			refreshPanels();
			// The server publishes cheap diagnostics on every keystroke and
			// defers the minify-lint pass to us; this is our half of that.
			session.refreshInsights();
		}

		for (const box of document.querySelectorAll<HTMLInputElement>('[data-option]')) {
			box.addEventListener('change', refreshPanels);
		}

		copyButton?.addEventListener('click', async () => {
			await navigator.clipboard.writeText(minified.state.doc.toString());
			copyButton.textContent = 'Copied!';
			setTimeout(() => (copyButton.textContent = 'Copy'), 1500);
		});

		// A tab panel is `hidden` until selected, so the minified editor can be
		// laid out at zero height. Re-measure whenever the tabs are used.
		document
			.querySelector('starlight-tabs')
			?.addEventListener('click', () => requestAnimationFrame(() => minified.requestMeasure()));

		settled();
	}

	if (host) {
		boot(host).catch((error) => {
			setStatus(`Language server failed to start: ${error?.message ?? error}`, true);
		});
	}
</script>

<style>
	.playground {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-block: 1.5rem;
	}

	@media (max-width: 768px) {
		.playground {
			grid-template-columns: 1fr;
		}
	}

	.pane {
		display: flex;
		flex-direction: column;
		min-width: 0;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		overflow: hidden;
		background-color: var(--sl-color-bg);
	}

	.pane-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		background-color: var(--sl-color-bg-nav);
	}

	.pane-title {
		margin: 0;
		font-family: var(--sl-font-system-mono);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.pane-status {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.pane-status.failed {
		color: var(--sl-color-red-high);
	}

	.pane-body {
		height: min(65vh, 34rem);
	}

	/* CodeMirror scrolls itself. A second scroller on the wrapper would fight
	   it: `scrollIntoView`, hover and click coordinates all resolve against
	   the editor's own scroller, and would drift by the wrapper's offset. */
	.editor {
		overflow: hidden;
	}

	/* Matches the CodeMirror metrics in editor-theme.ts, so swapping the
	   fallback for the real editor does not move the text. */
	.editor .fallback {
		height: 100%;
		margin: 0;
		padding: 0.25rem 0.75rem;
		border: 0;
		border-radius: 0;
		overflow: auto;
		font-family: var(--sl-font-system-mono);
		font-size: var(--sl-text-code-sm);
		line-height: 1.6;
		background-color: var(--sl-color-bg);
	}

	/* The tab machinery is Starlight's, so its elements are not in this
	   component's template and need `:global`. Unlayered rules beat Starlight's
	   `@layer starlight.components`, so no specificity games are needed — but
	   the whole chain has to opt out of block layout for the panel to scroll
	   inside a fixed-height pane rather than stretching it. */
	.panels {
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

	.panels :global(starlight-tabs) {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-height: 0;
	}

	.panels :global([role='tablist']) {
		margin: 0;
		padding: 0 0.5rem;
		background-color: var(--sl-color-bg-nav);
	}

	.panels :global([role='tabpanel']) {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-height: 0;
		margin-top: 0 !important;
	}

	/* Starlight hides unselected panels with the `hidden` attribute, which the
	   UA stylesheet implements as `display: none` — a rule the `display: flex`
	   above outranks. Without this the three panels stack on top of each
	   other and the minified editor is squeezed to nothing. */
	.panels :global([role='tabpanel'][hidden]) {
		display: none;
	}

	.tab-body {
		flex: 1;
		min-height: 0;
		padding: 0.5rem 0.75rem;
	}

	/* Only the minified tab is a flex column, because only it has a child
	   that must absorb the leftover height (the read-only editor). */
	.tab-body.minify {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	/* The table panels stay in block layout and simply scroll. As flex items
	   the `overflow-x: auto` table wrappers had no min-content height, so
	   flex-shrink collapsed every table to nothing while the headings between
	   them still rendered — visible only by looking, since the rows were
	   still in `textContent`. */
	.tab-body.scrolls {
		overflow: auto;
	}

	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
	}

	.pill {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.1rem 0.5rem 0.1rem 0.3rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		cursor: pointer;
		user-select: none;
	}

	.pill:hover {
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-white);
	}

	.pill input {
		margin: 0;
		accent-color: var(--sl-color-text-accent);
	}

	/* Four figures plus a button rarely fit one line in half a pane, so both
	   rows wrap and share a baseline — otherwise the numbers stagger. */
	.stats-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 0.5rem;
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem 0.75rem;
	}

	.stats :global(.stat) {
		display: flex;
		align-items: baseline;
		gap: 0.3rem;
		font-size: var(--sl-text-xs);
	}

	.stats :global(.stat-label) {
		color: var(--sl-color-gray-3);
	}

	.stats :global(.stat-value) {
		font-family: var(--sl-font-system-mono);
		color: var(--sl-color-white);
	}

	.stats :global(.highlight .stat-value) {
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}

	.copy {
		flex: none;
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.25rem;
		background-color: var(--sl-color-bg-nav);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-white);
		cursor: pointer;
	}

	.copy:hover:not(:disabled) {
		border-color: var(--sl-color-text-accent);
	}

	.copy:disabled {
		opacity: 0.5;
		cursor: default;
	}

	.minified {
		flex: 1;
		min-height: 0;
		overflow: hidden;
	}

	.notice {
		padding: 0.4rem 0.6rem;
		border-left: 2px solid var(--sl-color-red);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-red-high);
	}

	.notice :global(p) {
		margin: 0;
	}

	.empty {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	/* Tables come from render.ts, so they are all `:global`. */
	.tab-body :global(.section-title) {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0.75rem 0 0.25rem;
		font-family: var(--sl-font-system-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-white);
	}

	.tab-body :global(.section-title:first-child) {
		margin-top: 0;
	}

	.tab-body :global(.note) {
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}

	.tab-body :global(.table-scroll) {
		overflow-x: auto;
	}

	.tab-body :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--sl-font-system-mono);
		font-size: var(--sl-text-xs);
	}

	.tab-body :global(th) {
		text-align: left;
		font-weight: 600;
		color: var(--sl-color-gray-3);
	}

	.tab-body :global(th),
	.tab-body :global(td) {
		padding: 0.15rem 0.5rem 0.15rem 0;
		border-bottom: 1px solid var(--sl-color-hairline);
		white-space: nowrap;
		color: var(--sl-color-gray-1);
	}

	.tab-body :global(.raw) {
		margin-top: 0.75rem;
		font-size: var(--sl-text-xs);
	}

	.tab-body :global(.raw summary) {
		cursor: pointer;
		color: var(--sl-color-gray-3);
	}

	.tab-body :global(.raw pre) {
		max-height: 20rem;
		overflow: auto;
		font-size: var(--sl-text-xs);
	}

	.tab-body :global(.diagnostics) {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tab-body :global(.diagnostic) {
		display: flex;
		gap: 0.5rem;
		width: 100%;
		padding: 0.25rem 0.4rem;
		border: 0;
		border-left: 2px solid transparent;
		border-radius: 0.25rem;
		background: none;
		text-align: left;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}

	.tab-body :global(.diagnostic:hover) {
		background-color: var(--sl-color-gray-6);
	}

	.tab-body :global(.diagnostic.error) {
		border-left-color: var(--sl-color-red);
	}

	.tab-body :global(.diagnostic.warning) {
		border-left-color: var(--sl-color-orange);
	}

	.tab-body :global(.diagnostic-where),
	.tab-body :global(.diagnostic-code) {
		flex: none;
		font-family: var(--sl-font-system-mono);
		color: var(--sl-color-gray-3);
	}

	.tab-body :global(.diagnostic-message) {
		min-width: 0;
	}
</style>
