.{
    .name = .wgslender,
    .version = "1.6.0",
    .fingerprint = 0x69278284534a33a0,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "cli",
        "lsp",
        "tests",
    },
    .dependencies = .{
        // Fetched by URL rather than vendored as a submodule: `git archive`
        // (and therefore every GitHub release tarball) drops submodule
        // contents, which left `zig build lsp` unbuildable for anyone
        // consuming a release. Pinned to the exact upstream commit that the
        // submodule tracked, so this is a packaging change only.
        .lsp_kit = .{
            .url = "https://github.com/zigtools/lsp-kit/archive/ec325a3c33d1da7708cf513355208f74d9560580.tar.gz",
            .hash = "lsp_kit-0.1.0-bi_PL_kyDACVTEhLaMq2-PJx0MocqRyjXDAN0ybMUyQQ",
            .lazy = true,
        },
        // SJON — the pngine project-document parser (pngine-shaders
        // phase 01). Same URL+hash rule as lsp_kit above: a path into the
        // sibling checkout resolves on one machine only, and the build
        // runner opens every declared path before it looks at the
        // requested step. Pinned to upstream tag v1.7.0 (commit
        // 3dcbf5ffd2876b13a4d91c787e7f30f232241712) by commit archive
        // URL — the tag is mutable, the commit is not; v1.7.1 is
        // excluded because `src/version.zig` reports 1.7.1 there and the
        // plans are written against the 1.7.0 API. `.lazy = true` keeps
        // it off every build that does not ask for it: only the native
        // path in build.zig calls `b.lazyDependency("sjon", …)`, so
        // `-Dlsp=false` (and the offline `wgslender-sys/build.rs` lane)
        // never fetches it. Resolved with `plugin-exec=false` — no
        // libwasmtime link, declarative plugins only.
        .sjon = .{
            .url = "https://github.com/HugoDaniel/SJON/archive/3dcbf5ffd2876b13a4d91c787e7f30f232241712.tar.gz",
            .hash = "sjon-1.7.0-QUbZyxHcfwDiZqFZGDixxbTWrlKyTfA3M-6gqNXh2F2V",
            .lazy = true,
        },
    },
}
